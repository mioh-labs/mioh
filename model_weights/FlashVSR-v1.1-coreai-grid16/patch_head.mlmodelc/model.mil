            tensor<int32, [5]> const_1 = const()[name = string("const_1"), val = tensor<int32, [5]>([0, 2, 3, 4, 1])];
            tensor<int32, [3]> const_2 = const()[name = string("const_2"), val = tensor<int32, [3]>([1, 1536, 1536])];
            tensor<fp16, [1, 6, 16, 16, 1536]> permute_cast_fp16 = transpose(perm = const_1, x = conv3d_cast_fp16)[name = string("transpose_0")];
            tensor<fp16, [1, 1536, 1536]> x = reshape(shape = const_2, x = permute_cast_fp16)[name = string("view_cast_fp16")];
        } -> (x);
    func patch_next<ios18>(tensor<fp16, [1, 16, 2, 32, 32]> latent) {
