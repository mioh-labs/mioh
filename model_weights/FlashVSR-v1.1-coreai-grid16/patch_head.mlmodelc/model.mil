    func patch_first<ios18>(tensor<fp16, [1, 16, 6, 32, 32]> latent) {
            string conv3d_pad_type_0 = const()[name = string("conv3d_pad_type_0"), val = string("valid")];
            tensor<int32, [3]> conv3d_strides_0 = const()[name = string("conv3d_strides_0"), val = tensor<int32, [3]>([1, 2, 2])];
            tensor<int32, [6]> conv3d_pad_0 = const()[name = string("conv3d_pad_0"), val = tensor<int32, [6]>([0, 0, 0, 0, 0, 0])];
            tensor<int32, [3]> conv3d_dilations_0 = const()[name = string("conv3d_dilations_0"), val = tensor<int32, [3]>([1, 1, 1])];
            int32 conv3d_groups_0 = const()[name = string("conv3d_groups_0"), val = int32(1)];
            tensor<fp16, [1536, 16, 1, 2, 2]> p_projection_weight_to_fp16 = const()[name = string("p_projection_weight_to_fp16"), val = tensor<fp16, [1536, 16, 1, 2, 2]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(64)))];
            tensor<fp16, [1536]> p_projection_bias_to_fp16 = const()[name = string("p_projection_bias_to_fp16"), val = tensor<fp16, [1536]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(196736)))];
