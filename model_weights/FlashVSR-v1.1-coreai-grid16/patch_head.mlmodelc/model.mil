            tensor<fp16, [1, 2, 64, 16, 16]> permute_cast_fp16 = transpose(perm = const_5, x = view_cast_fp16)[name = string("transpose_1")];
            tensor<fp16, [2, 64, 16, 16]> view_1_cast_fp16 = reshape(shape = const_6, x = permute_cast_fp16)[name = string("view_1_cast_fp16")];
            string conv_transpose2d_pad_type_0 = const()[name = string("conv_transpose2d_pad_type_0"), val = string("valid")];
            tensor<int32, [2]> conv_transpose2d_strides_0 = const()[name = string("conv_transpose2d_strides_0"), val = tensor<int32, [2]>([2, 2])];
            tensor<int32, [4]> conv_transpose2d_pad_0 = const()[name = string("conv_transpose2d_pad_0"), val = tensor<int32, [4]>([0, 0, 0, 0])];
            tensor<int32, [2]> conv_transpose2d_dilations_0 = const()[name = string("conv_transpose2d_dilations_0"), val = tensor<int32, [2]>([1, 1])];
            int32 conv_transpose2d_groups_0 = const()[name = string("conv_transpose2d_groups_0"), val = int32(1)];
