            tensor<fp16, [1, 1536, 2, 16, 16]> conv3d_cast_fp16 = conv(bias = p_projection_bias_to_fp16, dilations = conv3d_dilations_0, groups = conv3d_groups_0, pad = conv3d_pad_0, pad_type = conv3d_pad_type_0, strides = conv3d_strides_0, weight = p_projection_weight_to_fp16, x = latent)[name = string("conv3d_cast_fp16")];
