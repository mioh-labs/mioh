      "medium_load": {
        "performance_gain_percent": -23.2,
        "recommendation": "disable_optimization", 
        "confidence": 0.95
      },
      "heavy_load": {
        "performance_gain_percent": 63.4,
        "recommendation": "enable_optimization",
        "confidence": 0.98
      },
      "stress_test": {
        "performance_gain_percent": 51.3,
        "recommendation": "enable_full_optimization",
        "confidence": 0.97
      }
