  "load_level_configs": {
    "description": "define configuration parameters for different load levels",
    
    "light_load": {
      "description": "light load - performance loss 23%, disable optimization",
      "enable_optimization": false,
      "expected_performance_change": -23.0,
      "characteristics": {
        "frame_pixels_max": 1440000,
        "batch_size_max": 2,
        "processing_complexity_max": 0.4,
        "typical_scenarios": ["preview", "single_frame_view", "thumbnail_generation"]
      }
    },
    
    "medium_load": {
      "description": "medium load - performance loss 23.2%, disable optimization",
      "enable_optimization": false,
      "expected_performance_change": -23.2,
      "characteristics": {
        "frame_pixels_range": [1440000, 2073600],
        "batch_size_range": [2, 4],
        "processing_complexity_range": [0.4, 0.6],
        "typical_scenarios": ["small_batch_processing", "720p_restoration", "quick_preview"]
      }
    },
    
    "heavy_load": {
      "description": "heavy load - performance gain 63.4%, enable optimization",
      "enable_optimization": true,
      "expected_performance_change": 63.4,
      "characteristics": {
        "frame_pixels_range": [2073600, 8294400],
        "batch_size_range": [4, 8],
        "processing_complexity_range": [0.6, 0.8],
        "typical_scenarios": ["1080p_restoration", "medium_batch_processing", "quality_enhancement"]
      },
      "optimization_config": {
        "enable_gpu_acceleration": true,
        "enable_memory_optimization": true,
        "enable_batch_processing": true,
        "enable_predictive_scheduling": false,
        "max_concurrent_tasks": 4,
        "memory_pool_size_mb": 1024
      }
    },
    
    "stress_load": {
      "description": "stress load - performance gain 51.3%, enable full optimization",
      "enable_optimization": true,
      "expected_performance_change": 51.3,
      "characteristics": {
        "frame_pixels_min": 8294400,
        "batch_size_min": 8,
        "processing_complexity_min": 0.8,
        "typical_scenarios": ["4k_restoration", "large_batch_export", "professional_processing"]
      },
      "optimization_config": {
        "enable_gpu_acceleration": true,
        "enable_memory_optimization": true,
        "enable_batch_processing": true,
        "enable_predictive_scheduling": true,
        "max_concurrent_tasks": 6,
        "memory_pool_size_mb": 2048
      }
    }
